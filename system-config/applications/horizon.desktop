[Desktop Entry]
Type=Application
Version=1.0
Name=Horizon
GenericName=Analyse de scénarios boursiers
Comment=Analyse locale, scénarios et suivi des performances
Exec=__HOME__/.local/bin/horizon
Icon=__HOME__/.local/share/icons/hicolor/scalable/apps/horizon.svg
Terminal=false
Categories=Office;Finance;
StartupNotify=true
StartupWMClass=Horizon
Actions=Stop;

[Desktop Action Stop]
Name=Arrêter Horizon
Exec=__HOME__/.local/bin/horizon-stop
