#!/usr/bin/env bash
set -u

ACTION="${1:-}"
LOG_FILE="${XDG_CACHE_HOME:-$HOME/.cache}/precision-session-actions.log"
mkdir -p "$(dirname "$LOG_FILE")"

notify_failure() {
    local message="$1"
    printf '%s %s\n' "$(date --iso-8601=seconds)" "$message" >>"$LOG_FILE"

    if command -v notify-send >/dev/null 2>&1; then
        notify-send "Precision Shell" "$message"
    fi
}

case "$ACTION" in
    lock)
        if [[ -x "$HOME/.local/bin/precision-lock" ]]; then
            exec "$HOME/.local/bin/precision-lock"
        fi

        if command -v loginctl >/dev/null 2>&1; then
            exec loginctl lock-session
        fi

        notify_failure "Impossible de verrouiller la session."
        exit 1
        ;;

    suspend)
        if command -v systemctl >/dev/null 2>&1; then
            exec systemctl suspend
        fi

        notify_failure "La mise en veille est indisponible."
        exit 1
        ;;

    logout)
        if command -v niri >/dev/null 2>&1; then
            if niri msg action quit --help 2>&1 \
                    | grep -q -- '--skip-confirmation'; then
                exec niri msg action quit --skip-confirmation
            fi

            exec niri msg action quit
        fi

        notify_failure "Impossible de fermer la session Niri."
        exit 1
        ;;

    reboot)
        if command -v systemctl >/dev/null 2>&1; then
            exec systemctl reboot
        fi

        notify_failure "Le redémarrage est indisponible."
        exit 1
        ;;

    poweroff)
        if command -v systemctl >/dev/null 2>&1; then
            exec systemctl poweroff
        fi

        notify_failure "L'arrêt du PC est indisponible."
        exit 1
        ;;

    *)
        notify_failure "Action de session inconnue : $ACTION"
        exit 2
        ;;
esac
