#!/usr/bin/env bash
set -euo pipefail

STATE_DIR="${XDG_STATE_HOME:-$HOME/.local/state}/precision-shell"
STATE_FILE="$STATE_DIR/dnd"
mkdir -p "$STATE_DIR"

read_state() {
    if [[ -f "$STATE_FILE" ]] \
            && [[ "$(cat "$STATE_FILE")" == "on" ]]; then
        printf 'on\n'
    else
        printf 'off\n'
    fi
}

apply_on() {
    if command -v swaync-client >/dev/null 2>&1 \
            && pgrep -x swaync >/dev/null 2>&1; then
        swaync-client -dn -sw >/dev/null 2>&1 || true
    fi

    if command -v makoctl >/dev/null 2>&1 \
            && pgrep -x mako >/dev/null 2>&1; then
        makoctl mode -a do-not-disturb >/dev/null 2>&1 || true
    fi

    if command -v dunstctl >/dev/null 2>&1 \
            && pgrep -x dunst >/dev/null 2>&1; then
        dunstctl set-paused true >/dev/null 2>&1 || true
    fi

    if command -v gsettings >/dev/null 2>&1 \
            && gsettings list-schemas \
            | grep -qx org.gnome.desktop.notifications; then
        gsettings set \
            org.gnome.desktop.notifications \
            show-banners false >/dev/null 2>&1 || true
    fi
}

apply_off() {
    if command -v swaync-client >/dev/null 2>&1 \
            && pgrep -x swaync >/dev/null 2>&1; then
        swaync-client -df -sw >/dev/null 2>&1 || true
    fi

    if command -v makoctl >/dev/null 2>&1 \
            && pgrep -x mako >/dev/null 2>&1; then
        makoctl mode -r do-not-disturb >/dev/null 2>&1 || true
    fi

    if command -v dunstctl >/dev/null 2>&1 \
            && pgrep -x dunst >/dev/null 2>&1; then
        dunstctl set-paused false >/dev/null 2>&1 || true
    fi

    if command -v gsettings >/dev/null 2>&1 \
            && gsettings list-schemas \
            | grep -qx org.gnome.desktop.notifications; then
        gsettings set \
            org.gnome.desktop.notifications \
            show-banners true >/dev/null 2>&1 || true
    fi
}

set_state() {
    local next="$1"
    printf '%s\n' "$next" > "$STATE_FILE"

    if [[ "$next" == "on" ]]; then
        apply_on
    else
        apply_off
    fi

    printf '%s\n' "$next"
}

case "${1:-status}" in
    status)
        read_state
        ;;
    on)
        set_state on
        ;;
    off)
        set_state off
        ;;
    toggle)
        if [[ "$(read_state)" == "on" ]]; then
            set_state off
        else
            set_state on
        fi
        ;;
    apply)
        if [[ "$(read_state)" == "on" ]]; then
            apply_on
        else
            apply_off
        fi
        ;;
    *)
        echo "Usage: precision-dnd status|on|off|toggle|apply" >&2
        exit 2
        ;;
esac
